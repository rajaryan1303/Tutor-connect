# Server
PORT=5000
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/tutor_connect

# Authentication
JWT_SECRET=your_super_secret_jwt_key_change_in_production

# Razorpay (optional - used for real payments)
# Leave empty to use the built-in sandbox payment flow.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# CORS - comma separated list of allowed origins (empty = all origins)
CORS_ORIGINS=http://localhost:3000